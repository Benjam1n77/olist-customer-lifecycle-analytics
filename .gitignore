# ---- 数据文件（原始数据不得提交） ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
*.csv
*.zip
*.parquet
*.sqlite
*.db

# ---- 敏感配置 ----
.env
.env.*
config/config.yaml
config/config.local.yaml
*.pem
*.key
kaggle.json
credentials.json

# ---- 完整个人简历（含联系方式，仅保留在本地） ----
/docs/resume/resume_full.tex

# ---- 本地生成的报告副本（以 Markdown 源文件为发布版本） ----
docs/project_report.html
docs/project_report.pdf

# ---- 本地生成产物与旧工具（任何文件类型均不发布） ----
/outputs/local/
/tools/legacy/

# ---- 分析输出（按需提交，默认忽略大体积产物） ----
